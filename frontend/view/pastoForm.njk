{% extends "layout.njk" %}

{% block conteudo %}

<div class="ph">
    <div>
        <h1>{{ title }}</h1>
        <p>Dados cadastrais do pasto.</p>
    </div>
</div>

<section class="card">

    <form
        id="formPasto"
        data-id="{{ id }}"
        data-modo="{{ modo }}">

        <div class="form">

            <div class="field full">
                <label for="descricao">
                    Descrição do pasto
                </label>

                <input
                    type="text"
                    id="descricao"
                    maxlength="100"
                    required>
            </div>

            <div class="field">
                <label for="areatotal">
                    Área total (hectares)
                </label>

                <input
                    type="number"
                    id="areatotal"
                    step="0.01"
                    min="0.01"
                    required>
            </div>

        </div>

        <div class="row" style="margin-top:20px">

            <button
                type="submit"
                id="btnSalvar"
                class="btn pri">
                Salvar
            </button>

            <a href="/pastos" class="btn">
                Voltar
            </a>

        </div>

        <p
            id="mensagemFormulario"
            class="mensagem-erro"
            hidden>
        </p>

    </form>

</section>

{% endblock %}

{% block scripts %}
<script src="/apps/pastos/vwPastoForm.js"></script>
{% endblock %}