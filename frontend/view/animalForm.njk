{% extends "layout.njk" %}

{% block conteudo %}

<div class="ph">
    <div>
        <h1>{{ title }}</h1>
        <p>Dados cadastrais do animal.</p>
    </div>
</div>

<section class="card">

    <form id="formAnimal"
          data-id="{{ id }}"
          data-modo="{{ modo }}">

        <div class="form">

            <div class="field full">
                <label for="nome">Nome do animal</label>

                <input
                    type="text"
                    id="nome"
                    maxlength="100"
                    required>
            </div>

            <div class="field">
                <label for="datanasc">
                    Data de nascimento
                </label>

                <input
                    type="date"
                    id="datanasc"
                    required>
            </div>

        </div>

        <div class="row" style="margin-top:20px">

            <button type="submit"
                    id="btnSalvar"
                    class="btn pri">
                Salvar
            </button>

            <a href="/animais" class="btn">
                Voltar
            </a>

        </div>

        <p id="mensagemFormulario"
           class="mensagem-erro"
           hidden></p>

    </form>

</section>

{% endblock %}

{% block scripts %}
<script src="/apps/animais/vwAnimalForm.js"></script>
{% endblock %}