### Login
# @name login
POST http://localhost:40000/Login
Content-Type: application/json

{
    "username": "user1",
    "password": "1234"
}

###

@token = {{login.response.body.$.token}}

### Criar pasto
# @name novoPasto
POST http://localhost:40000/insertPasto
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "descricao": "Pasto de Integração",
    "areatotal": 30.00
}

###

@pastoId = {{novoPasto.response.body.$.id}}

### Criar piquete
# @name novoPiquete
POST http://localhost:40000/insertPiquete
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "descricao": "Piquete de Integração",
    "latitude": -20.42,
    "longitude": -49.97,
    "pastoidfk": {{pastoId}}
}

###

@piqueteId = {{novoPiquete.response.body.$.id}}

### Criar animal
# @name novoAnimal
POST http://localhost:40000/insertAnimal
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "nome": "Animal de Teste",
    "datanasc": "2024-05-12"
}

###

@animalId = {{novoAnimal.response.body.$.id}}

### Criar alocação
# @name novaAlocacao
POST http://localhost:40000/insertAlocado
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "animalidfk": {{animalId}},
    "piqueteidfk": {{piqueteId}},
    "datainicio": "2026-11-18",
    "datafinal": null
}

###

@alocadoId = {{novaAlocacao.response.body.$.id}}

### Listar alocações
GET http://localhost:40000/getAllAlocados
Authorization: Bearer {{token}}

###

### Buscar alocação
GET http://localhost:40000/getAlocadoByID/{{alocadoId}}
Authorization: Bearer {{token}}

###

### Atualizar alocação
PUT http://localhost:40000/updateAlocado/{{alocadoId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "animalidfk": {{animalId}},
    "piqueteidfk": {{piqueteId}},
    "datainicio": "2026-11-18",
    "datafinal": "2026-11-25"
}

###

### Excluir alocação
DELETE http://localhost:40000/deleteAlocado/{{alocadoId}}
Authorization: Bearer {{token}}